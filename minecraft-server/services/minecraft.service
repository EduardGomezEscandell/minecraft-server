[Unit]
Description=Minecraft Server
After=getty.service

[Service]
ExecStart=docker run                                                                                       \
		--rm -p "0.0.0.0:{{server_port}}:25565"                                                            \
		--name minecraft                                                                                   \
		--interactive                                                                                      \
		--mount "type=bind,src=/data/minecraft/world,dst=/server/world"                             \
		--mount "type=bind,src=/data/minecraft/logs,dst=/server/logs"                               \
		--mount "type=bind,src=/data/minecraft/banned-ips.json,dst=/server/banned-ips.json"         \
		--mount "type=bind,src=/data/minecraft/banned-players.json,dst=/server/banned-players.json" \
		--mount "type=bind,src=/data/minecraft/ops.json,dst=/server/ops.json"                       \
		--mount "type=bind,src=/data/minecraft/usercache.json,dst=/server/usercache.json"           \
		--mount "type=bind,src=/data/minecraft/whitelist.json,dst=/server/whitelist.json"           \
		minecraft:latest

ExecStop=docker stop minecraft
ExecReload=docker restart minecraft

Sockets=minecraft.socket
StandardInput=socket
StandardOutput=journal
StandardError=journal

Type=simple
RemainAfterExit=false

Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target