#!/bin/bash
set -eu

STORAGE_ACCOUNT_NAME="$1"
STORAGE_CONTAINER_NAME="$2"
SERVICE_ACCOUNT_NAME="${3:-}"

echo "STORAGE_ACCOUNT_NAME   = ${STORAGE_ACCOUNT_NAME}"
echo "STORAGE_CONTAINER_NAME = ${STORAGE_CONTAINER_NAME}"
echo "SERVICE_ACCOUNT_NAME   = ${SERVICE_ACCOUNT_NAME}"

if ! az account show &> /dev/null; then
    az login --identity --allow-no-subscriptions
    echo "Logged in to Azure CLI with identity: ${SERVICE_ACCOUNT_NAME}"
fi

tmpdir=$(mktemp -d)
timestamp=$(date +'%Y%m%d_%H')
mkdir -p "${tmpdir}/${timestamp}"

echo "Created temporary directory: ${tmpdir}/${timestamp}"

cd /opt/minecraft/
for file in banned-ips.json banned-players.json logs/latest-log ops.json whitelist.json world; do
    cp -r "$file" "${tmpdir}/${timestamp}" 2>/dev/null || true
done

cd "${tmpdir}"
tar -czf "${timestamp}.tar.gz" "${timestamp}"

echo "Created backup: ${tmpdir}/${timestamp}.tar.gz"

# Upload to Azure Blob Storage
az storage blob upload \
    --account-name "${STORAGE_ACCOUNT_NAME}" \
    --container-name "${STORAGE_CONTAINER_NAME}" \
    --name "${timestamp}" \
    --file "${timestamp}.tar.gz" \
    --no-progress \
    --type block \
    --tier Cool \
    --auth-mode login \
    --overwrite \
    --output none

echo "Backup uploaded to Azure Blob Storage: ${STORAGE_ACCOUNT_NAME}/${STORAGE_CONTAINER_NAME}/${timestamp}"